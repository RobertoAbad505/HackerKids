    "portfolio.pokemon.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A modern prototype demonstrating list rendering using LazyLoad, reusable components, detail navigation and more features using a public API."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un prototipo moderno haciendo list rendering usando LazyLoad, componentes reusables, navegacion por detalles y más funcionalidades usando una API publica."
          }
        }
      }
    },
    "portfolio.rickAndMorty.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Display a modern grid built with reusable components by fetching data from a public API. Built with MVVM architecture, infinite scrolling, pagination and more."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un grid moderno hecho con componentes reusables y modelados por data obtenida desde una API. Desarrollado con arquitectura MVVM, scroll infinito y paginación."
          }
        }
      }
    },
    "portfolio.soupgame.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A word search game built with SwiftUI. Find all the words as quickly as you can to win the challenge!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un juego de sopa de letras hecho con SwiftUI. Encuentra todas las palabras lo más rápido que puedas para ganar el reto."
          }
        }
      }
    },
    "portfolio.weather.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get real-time weather updates based on your current location. Uses GPS to display current conditions, forecasts, and more."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta el clima en tiempo real usando tu ubicación actual. Usa el GPS para mostrar las condiciones actuales, el pronóstico y más."
          }
        }
      }
    },
    "portfolioDescriptionKey" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A curated selection of modules I've personally developed using SwiftUI. These prototypes showcase various techniques, custom components, API integration, HTTP requests, interface design, and more."
          }
        },
        "es-419" : {
          "stringUnit" : {
