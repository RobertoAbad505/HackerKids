    "portfolio.pokemon.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Pokédex tool built with SwiftUI. Includes API integration, infinite scrolling, search functionality, and pagination. Explore detailed stats, abilities, and types for each Pokémon."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una herramienta Pokédex creada con SwiftUI. Incluye integración con API, scroll infinito, búsqueda y paginación. Explora las estadísticas, habilidades y tipos de cada Pokémon."
          }
        }
      }
    },
    "portfolio.rickAndMorty.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Display a list of Rick and Morty characters by fetching data from an API. Built with MVVM architecture, infinite scrolling, pagination and more."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una lista de personajes de Rick and Morty obtenidos desde una API. Desarrollado con arquitectura MVVM, scroll infinito y paginación."
          }
        }
      }
    },
    "portfolio.soupgame.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A word search game built with SwiftUI. Find all the words as quickly as you can to win the challenge!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un juego de sopa de letras hecho con SwiftUI. Encuentra todas las palabras lo más rápido que puedas para ganar el reto."
          }
        }
      }
    },
    "portfolio.weather.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get real-time weather updates based on your current location. Uses GPS to display current conditions, forecasts, and more."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta el clima en tiempo real usando tu ubicación actual. Usa el GPS para mostrar las condiciones actuales, el pronóstico y más."
          }
        }
      }
    },
    "portfolioDescriptionKey" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A curated selection of modules I've personally developed using SwiftUI. These prototypes showcase various techniques, custom components, API integration, HTTP requests, interface design, and more."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una colección de módulos  que he desarrollado personalmente con SwiftUI. Estos prototipos incluyen diversas técnicas, componentes personalizados, integración con APIs, llamadas HTTP, diseño de interfaces y mucho más."
          }
        }
      }
